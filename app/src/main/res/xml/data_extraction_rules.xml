<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 数据提取规则：云备份与设备迁移均排除 Room 数据库，
  理由同 backup_rules.xml。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
